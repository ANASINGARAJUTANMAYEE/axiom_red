# AXIOM RED — Environment Variables
# Copy this to .env and fill in your API keys

# ── LLM Provider ─────────────────────────────────────────────────────
# Choose: gemini | openai | ollama
LLM_PROVIDER=gemini

# Google Gemini (recommended — free tier available)
# Get your key at: https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_google_api_key_here

# OpenAI (alternative)
OPENAI_API_KEY=your_openai_api_key_here

# ── Target Network (Docker internal) ─────────────────────────────────
TARGET_NETWORK=172.20.0.0/24

# Optional model overrides (defaults shown)
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODELS=gemini-3.8-flash
OPENAI_MODEL=gpt-4o

# Local model fallback (auto-activated if Gemini fails and Ollama is running)
# No API key needed — just run: ollama pull llama3.1:8b
OLLAMA_MODEL=llama3.1:8b
OLLAMA_HOST=http://localhost:11434
